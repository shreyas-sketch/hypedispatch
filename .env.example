# Your Anthropic API key (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# Dashboard address: http://localhost:4321
PORT=4321

# Who can open the dashboard. 127.0.0.1 = this PC only (safest).
# Use 0.0.0.0 to open it from other devices on your network, and then also set a password below.
HOST=127.0.0.1

# Optional: password-protect the dashboard (any username works)
DASHBOARD_PASSWORD=

# Models (defaults shown)
FACT_MODEL=claude-sonnet-5-5
MSG_MODEL=claude-haiku-4-5-20251001

# Minutes between saving a reschedule and announcing it (time to cancel a mistake)
RESCHEDULE_DELAY_MIN=5

# No automatic daily messages after this time (IST); a message missed by then is skipped, not sent at night
LATEST_SEND_TIME=22:00

# Where data and WhatsApp logins are stored (default ./data; on Railway the attached volume is used automatically)
# DATA_DIR=

# Timezone all dates/times use
TIMEZONE=Asia/Kolkata

# Pause between groups, in milliseconds (random between min and max)
GROUP_GAP_MIN_MS=4000
GROUP_GAP_MAX_MS=7000
